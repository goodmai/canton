// Canton 3.x Configuration (Composable Topology)
// Replaces legacy 'domains' key with separate services

canton {
  participants {
    participant1 {
      storage.type = memory
      admin-api.port = 5011
      admin-api.address = 0.0.0.0
      ledger-api.port = 5012
      ledger-api.address = 0.0.0.0
      http-ledger-api.port = 5013
      http-ledger-api.address = 0.0.0.0
    }
  }

  sequencers {
    sequencer1 {
      storage.type = memory
      public-api.port = 5018
      public-api.address = 0.0.0.0
      admin-api.port = 5019
      admin-api.address = 0.0.0.0
    }
  }

  mediators {
    mediator1 {
      storage.type = memory
      admin-api.port = 5020
      admin-api.address = 0.0.0.0
    }
  }

}
